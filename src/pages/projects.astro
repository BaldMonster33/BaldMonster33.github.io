---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FittsRevenge from '../components/FittsRevenge.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import CruxProjectTeaser from '../components/CruxProjectTeaser.astro';
import { portfolioStories, academicOrder } from '../data/portfolio';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const academic = academicOrder.map(id => projects.find(project => project.id === id)).filter((project): project is NonNullable<typeof project> => Boolean(project && portfolioStories[project.id]));
const otherProjects = projects.filter(project => !portfolioStories[project.id]);

// A `component` demo opens the real piece rather than a copy of it, so the
// piece has to be on the page — dormant, waiting for its event.
const needsFrontDoor = projects.some(
  (p) => p.data.demo?.type === 'component' && p.data.demo.id === 'fitts-revenge'
);
---

<BaseLayout
  title="Projects"
  description="Projects I worked on in machine learning, computer vision, accessibility, and software engineering, with demos, code, and reports."
  wide
>
  {needsFrontDoor && <FittsRevenge auto={false} />}

  <div class="portfolio-head">
    <p class="eyebrow">University of Michigan / 2021–2023</p>
    <h1>Projects</h1>
    <div class="intro-row"><p>These are projects I worked on at Michigan, from editing images to building AR games. Each page explains what we tried, what I worked on, and how it turned out.</p><span class="study-count">{String(academic.length).padStart(2, '0')} <small>university<br />projects</small></span></div>
  </div>

  <div class="portfolio-grid">{academic.map((project,index) => <PortfolioCard project={project} story={portfolioStories[project.id]} index={index} featured={index === 0 || (academic.length % 2 === 0 && index === academic.length - 1)} />)}</div>

  <div class="other-heading"><h2>Work and side projects</h2><p>An example of my work at AWS, an app I use for bouldering, and a small experiment on this site.</p></div>
  <div class="grid">
    {
      otherProjects.map((project) => project.id === 'crux' ? <CruxProjectTeaser project={project} /> : (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          period={project.data.period}
          stack={project.data.stack}
          links={project.data.links}
          href={`/projects/${project.id}`}
          demo={project.data.demo}
        />
      ))
    }
  </div>
</BaseLayout>

<style>
  .portfolio-head { margin: 0 auto 2.8rem; }
  .eyebrow { font: .7rem var(--font-mono); color: var(--text-dim); text-transform: uppercase; letter-spacing: .08em; }
  h1 { font-size: clamp(2.6rem,5.7vw,5.1rem); letter-spacing: -.06em; line-height: 1.05; margin: 1.3rem 0 1.4rem; }
  .intro-row { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .intro-row p { color: var(--text-dim); font-size: .96rem; max-width: 58ch; }
  .study-count { display: flex; gap: .8rem; align-items: center; font-size: 2.5rem; letter-spacing: -.04em; }
  .study-count small { font: .62rem/1.6 var(--font-mono); letter-spacing: 0; color: var(--text-dim); }
  .portfolio-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.4rem; margin-inline: auto; }
  .other-heading { margin: 4rem auto 1.5rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
  .other-heading h2 { margin: .6rem 0; font-size: 1.8rem; } .other-heading > p:last-child { color: var(--text-dim); font-size: .9rem; }
  .grid {
    display: grid;
    gap: 1rem;
    margin-inline: auto;
  }
  @media(max-width:44rem) { .portfolio-grid { grid-template-columns: 1fr; } .study-count { display: none; } }
</style>
