---
import BaseLayout from '../layouts/BaseLayout.astro';

const launches = [
  { title: 'CloudWatch Log Analytics', href: 'https://aws.amazon.com/about-aws/whats-new/2026/06/amazon-cloudwatch-log-analytics/' },
  { title: 'CloudWatch Logs facets and data-source querying', href: 'https://aws.amazon.com/blogs/aws/amazon-cloudwatch-introduces-unified-data-management-and-analytics-for-operations-security-and-compliance/' },
  { title: 'Cross-account and cross-Region log centralization', href: 'https://aws.amazon.com/about-aws/whats-new/2025/09/amazon-cloudwatch-cross-account-cross-region-log-centralization/' },
  { title: 'Natural-language query generation for OpenSearch PPL and SQL', href: 'https://aws.amazon.com/about-aws/whats-new/2025/08/amazon-cloudwatch-natural-language-query-generation-opensearch-ppl-sql/' },
  { title: 'Generative AI observability (preview)', href: 'https://aws.amazon.com/about-aws/whats-new/2025/07/amazon-cloudwatch-generative-ai-observability-preview/' },
  { title: 'CloudWatch and OpenSearch integrated analytics', href: 'https://aws.amazon.com/blogs/aws/new-amazon-cloudwatch-and-amazon-opensearch-service-launch-an-integrated-analytics-experience/' },
  { title: 'CloudWatch Logs field indexes and enhanced log-group selection', href: 'https://aws.amazon.com/about-aws/whats-new/2024/11/amazon-cloudwatch-logs-field-indexes-log-group-selection-log-insights/' },
];

const projects = [
  { title: '3D Joint Estimation from Clothed Body Scans', href: '/projects/umtri-body-scan/' },
  { title: 'ICA-SeFa: Interpretable Semantic Directions in GANs', href: '/projects/ica-sefa/' },
  { title: 'XLNet for Verifiable Commonsense Reasoning', href: '/projects/xlnet-trip/' },
  { title: 'Interactive Segmented Style Transfer', href: '/projects/segmented-style-transfer/' },
  { title: 'SoundAround: Wearable Sound Localization', href: '/projects/soundaround/' },
];
---

<BaseLayout
  title="Resume"
  description="Le Qin — Software Development Engineer II at Amazon Web Services and University of Michigan computer science graduate."
>
  <header class="page-head"><h1>Resume</h1></header>

  <section class="block" aria-labelledby="education-heading">
    <div class="section-head"><h2 id="education-heading">Education</h2></div>
    <h3>University of Michigan</h3>
    <p>B.S.E. in Computer Science</p>
  </section>

  <section class="block" aria-labelledby="employment-heading">
    <div class="section-head"><h2 id="employment-heading">Current Employment</h2></div>
    <h3>Software Development Engineer II</h3>
    <p>Amazon Web Services</p>
  </section>

  <section class="block" aria-labelledby="launches-heading">
    <div class="section-head"><h2 id="launches-heading">AWS Launches I Contributed To</h2></div>
    <ul>
      {launches.map(launch => <li><a href={launch.href} rel="noopener">{launch.title}</a></li>)}
    </ul>
  </section>

  <section class="block" aria-labelledby="projects-heading">
    <div class="section-head"><h2 id="projects-heading">Selected Projects</h2></div>
    <ul>
      {projects.map(project => <li><a href={project.href}>{project.title}</a></li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .block + .block { margin-top: 2.5rem; }
  h3 { font-size: 1.0625rem; line-height: 1.45; }
  p { margin-top: 0.3rem; color: var(--text-dim); font-size: 0.9375rem; }
  ul { list-style: none; padding: 0; display: grid; gap: 1rem; }
  li { font-size: 0.9375rem; line-height: 1.6; }
</style>
