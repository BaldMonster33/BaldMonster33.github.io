---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import moment from '../assets/crux/key-moment.png';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
---

<article class="crux-teaser">
  <div class="copy">
    <p class="eyebrow">An iPhone app · {project.data.period}</p>
    <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
    <p>{project.data.description}</p>
    <div class="links">
      <a href={`/projects/${project.id}/`}>Take a look <span aria-hidden="true">→</span></a>
      {project.data.links.map(link => <a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}
    </div>
  </div>
  <a class="preview" href={`/projects/${project.id}/`} aria-label="Explore CRUX and see the app screenshots">
    <Image src={moment} width={660} widths={[330,660]} sizes="240px" format="webp" alt="CRUX Attempt screen with a climbing video and saved Key moment." loading="lazy" />
  </a>
</article>

<style>
  .crux-teaser { display: grid; grid-template-columns: 1.25fr 1fr; background: #151a12; border: 1px solid #414b31; border-radius: var(--radius); overflow: hidden; color: #f1f0e8; }
  .copy { padding: 2rem; align-self: center; }
  .eyebrow { font: .62rem/1.6 var(--font-mono); color: #ccf522; margin-bottom: 1rem; }
  h3 { font: 400 clamp(1.8rem,3vw,2.5rem)/1.1 Georgia,serif; letter-spacing: -.04em; margin-bottom: 1rem; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: #ccf522; }
  a:focus-visible { outline: 3px solid #ccf522; outline-offset: 4px; }
  .copy > p:not(.eyebrow) { color: #b0b4a9; font-size: .88rem; line-height: 1.8; }
  .links { display: flex; gap: .5rem 1.3rem; flex-wrap: wrap; margin-top: 1.3rem; }
  .links a { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; font-size: .73rem; }
  .links a:first-child { color: #ccf522; }
  .preview { display: block; height: 345px; padding-top: 1.8rem; background: radial-gradient(ellipse at bottom, #3b4824, #191f14 75%); overflow: hidden; }
  .preview img { width: 230px; height: auto; margin: auto; border: 5px solid #080b08; border-radius: 26px; transform: rotate(8deg); }
  @media (max-width:600px) { .crux-teaser { grid-template-columns: 1fr; } .copy { padding: 1.5rem; } .preview { height: 260px; } }
</style>
