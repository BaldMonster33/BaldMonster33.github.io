---
import BaseLayout from './BaseLayout.astro';
import ViewCount from '../components/ViewCount.astro';
import { formatDate } from '../utils/date';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, updated, tags } = post.data;
---

<BaseLayout title={title} description={description} ogType="article">
  <article class="post">
    <header>
      <div class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          updated && (
            <>
              <span class="sep">·</span>
              <span>updated {formatDate(updated)}</span>
            </>
          )
        }
        <ViewCount path={Astro.url.pathname} />
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {
        tags.length > 0 && (
          <div class="chip-row">
            {tags.map((tag) => (
              <a class="chip" href={`/tags/${tag}`}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer>
      <a href="/blog" class="back">← All posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  header {
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta time {
    color: var(--accent);
  }

  .sep {
    color: var(--border-strong);
  }

  h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 4.5vw, 2.375rem);
  }

  .lede {
    margin-top: 0.75rem;
    color: var(--text-dim);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .chip-row {
    margin-top: 1.15rem;
  }

  footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }
</style>
